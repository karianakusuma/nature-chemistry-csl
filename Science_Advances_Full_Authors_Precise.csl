<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0"
       class="in-text" default-locale="en-US">
  <info>
    <title>Science Advances - Full Authors</title>
    <title-short>Science Advances</title-short>
    <id>http://www.zotero.org/styles/science-advances-full-authors-custom</id>
    <link href="http://www.zotero.org/styles/science-advances-full-authors-custom" rel="self"/>
    <updated>2026-09-16T00:00:00+00:00</updated>
    <author>
      <name>Custom CSL</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Science Advances-style numeric citations with complete author lists.</summary>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter=", "
            delimiter-precedes-last="always"
            and="text"
            et-al-min="9999"
            et-al-use-first="9999"
            initialize="true"/>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter=", "
            delimiter-precedes-last="always"
            and="text"
            et-al-min="9999"
            et-al-use-first="9999"/>
      <label prefix=", " form="short"/>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="journal">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <macro name="volume">
    <text variable="volume" font-weight="bold"/>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <text variable="page"/>
      </if>
      <else-if variable="article-number">
        <text variable="article-number"/>
      </else-if>
      <else-if variable="number">
        <text variable="number"/>
      </else-if>
    </choose>
  </macro>

  <macro name="supplement">
    <choose>
      <if variable="volume">
        <group prefix=" " delimiter=", ">
          <text variable="volume" font-weight="bold"/>
          <text variable="issue" prefix=" (" suffix=")" font-style="normal"/>
        </group>
      </if>
    </choose>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>

    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>

      <choose>
        <!-- Journal article -->
        <if type="article-journal" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=". "/>

          <group delimiter=" ">
            <text macro="journal"/>
            <text macro="volume"/>
          </group>

          <text macro="pages" prefix=", " suffix=" "/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </if>

        <!-- Book chapter -->
        <else-if type="chapter" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=". "/>
          <text value="In " font-style="normal"/>
          <text variable="container-title" font-style="italic" suffix=", "/>
          <text macro="editor" suffix=", "/>
          <text macro="pages" prefix="pp. " suffix=" "/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </else-if>

        <!-- Book -->
        <else-if type="book" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" font-style="italic" suffix=". "/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </else-if>

        <!-- Thesis -->
        <else-if type="thesis" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=". "/>
          <text variable="genre" suffix=", "/>
          <text variable="publisher" suffix=", "/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </else-if>

        <!-- Web / other -->
        <else>
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=". "/>
          <text variable="container-title" font-style="italic" suffix=". "/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
