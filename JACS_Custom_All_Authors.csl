<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">
  <info>
    <title>JACS Custom - All Authors</title>
    <title-short>JACS Custom</title-short>
    <id>http://www.zotero.org/styles/jacs-custom-all-authors</id>
    <link href="http://www.zotero.org/styles/jacs-custom-all-authors" rel="self"/>
    <updated>2026-09-26T00:00:00+00:00</updated>
    <author>
      <name>Custom CSL</name>
    </author>
    <category citation-format="numeric"/>
    <category field="chemistry"/>
    <summary>Custom JACS/ACS-style citation with all authors displayed, based on the user's specified format.</summary>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="page-range-delimiter">−</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter="; "
            delimiter-precedes-last="always"
            and="never"
            et-al-min="999"
            et-al-use-first="999"/>
    </names>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year" font-weight="bold"/>
    </date>
  </macro>

  <macro name="volume">
    <text variable="volume" font-style="italic"/>
  </macro>

  <macro name="issue">
    <text variable="issue" prefix=" (" suffix=")"/>
  </macro>

  <macro name="pages">
    <text variable="page" prefix=", "/>
  </macro>

  <macro name="doi">
    <text variable="DOI" prefix=". DOI: https://doi.org/" />
  </macro>

  <citation>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=". "/>
      <text macro="title" suffix=". "/>
      <text macro="container"/>
      <text macro="issued" prefix=" "/>
      <text macro="volume" prefix=", "/>
      <text macro="issue"/>
      <text macro="pages"/>
      <text macro="doi"/>
    </layout>
  </bibliography>
</style>
