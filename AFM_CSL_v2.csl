<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0"
       class="in-text" default-locale="en-GB"
       demote-non-dropping-particle="sort-only">
  <info>
    <title>Advanced Functional Materials - Custom</title>
    <id>http://www.zotero.org/styles/advanced-functional-materials-custom-v2</id>
    <link href="https://advanced.onlinelibrary.wiley.com/hub/journal/16163028/author-guidelines" rel="documentation"/>
    <updated>2026-10-01T00:00:00+00:00</updated>
    <summary>Numeric citations and AFM-style bibliography using full article and journal titles, author truncation after six authors, year, pages or article number, and DOI.</summary>
    <category citation-format="numeric"/>
    <category field="science"/>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter=", "
            delimiter-precedes-last="never"
            and="symbol"
            et-al-min="7"
            et-al-use-first="3"/>
      <et-al/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" prefix="‘" suffix=",’"/>
  </macro>

  <macro name="journal">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="year">
    <date variable="issued" prefix=" (" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="2">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=", "/>
      <text macro="title" suffix=" "/>
      <text macro="journal" suffix=" "/>
      <choose>
        <if variable="volume">
          <text variable="volume"/>
          <choose>
            <if variable="issue">
              <text variable="issue" prefix=", no. "/>
            </if>
          </choose>
          <text macro="year" suffix=": "/>
        </if>
        <else>
          <text macro="year" suffix=": "/>
        </else>
      </choose>
      <choose>
        <if variable="page">
          <text variable="page"/>
        </if>
        <else-if variable="number">
          <text variable="number"/>
        </else-if>
      </choose>
      <choose>
        <if variable="DOI">
          <text macro="doi" prefix=". "/>
        </if>
      </choose>
    </layout>
  </bibliography>
</style>
