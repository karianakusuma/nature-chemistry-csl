<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0"
       class="in-text" default-locale="en-GB"
       demote-non-dropping-particle="sort-only">
  <info>
    <title>Nature Chemistry Custom - No Preprint Label</title>
    <id>http://www.zotero.org/styles/nature-chemistry-custom-no-preprint-label</id>
    <link href="https://www.nature.com/nchem/" rel="documentation"/>
    <updated>2026-09-08T00:00:00+00:00</updated>
    <summary>Custom Nature-style bibliography for journal articles: authors, title, abbreviated italic journal, bold volume, pages/article number, and year. DOI/URL is suppressed for journal articles.</summary>
    <category citation-format="numeric"/>
    <category field="science"/>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", "
            initialize-with=". " delimiter=", "
            delimiter-precedes-last="always" and="text"/>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" suffix=". "/>
  </macro>

  <macro name="journal">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="year">
    <date variable="issued" prefix=" (" suffix=").">
      <date-part name="year"/>
    </date>
  </macro>

  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=" "/>
      <text macro="title"/>
      <text macro="journal" suffix=" "/>
      <text variable="volume" font-weight="bold" suffix=", "/>
      <text variable="page"/>
      <text macro="year"/>
    </layout>
  </bibliography>
</style>
