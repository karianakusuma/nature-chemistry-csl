<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0"
       class="in-text" default-locale="en-US">

  <info>
    <title>Science Advances Custom - Full Authors</title>
    <title-short>Science Advances Custom</title-short>
    <id>http://www.zotero.org/styles/science-advances-custom-full-authors-v1</id>
    <link href="https://www.science.org/content/page/information-authors" rel="documentation"/>
    <updated>2026-09-16T00:00:00+00:00</updated>
    <summary>Science Advances-style references with all authors, full article titles, abbreviated italic journal names, bold volume, pages or article numbers, and year in parentheses.</summary>
    <category citation-format="numeric"/>
    <category field="science"/>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="never"
            initialize-with=". "
            delimiter=", "
            delimiter-precedes-last="always"
            and="text"/>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" suffix="."/>
  </macro>

  <macro name="journal">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <macro name="year">
    <date variable="issued" prefix=" (" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="locator">
    <choose>
      <if variable="page">
        <text variable="page"/>
      </if>
      <else-if variable="article-number">
        <text variable="article-number"/>
      </else-if>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="999"
                et-al-use-first="999"
                second-field-align="flush"
                entry-spacing="0"
                line-spacing="1">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=", "/>
      <text macro="title" suffix=" "/>
      <text macro="journal" suffix=" "/>
      <text variable="volume" font-weight="bold" suffix=", "/>
      <text macro="locator" suffix=" "/>
      <text macro="year"/>
    </layout>
  </bibliography>
</style>
