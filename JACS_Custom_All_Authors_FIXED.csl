<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0"
       class="in-text" default-locale="en-GB"
       demote-non-dropping-particle="sort-only">

  <info>
    <title>JACS Custom - All Authors</title>
    <id>http://www.zotero.org/styles/jacs-custom-all-authors</id>
    <link href="https://pubs.acs.org/journal/jacsat" rel="documentation"/>
    <updated>2026-09-26T00:00:00+00:00</updated>
    <summary>Custom JACS-style journal references: all authors, article title, abbreviated italic journal, bold year, italic volume, issue in parentheses, and page range.</summary>
    <category citation-format="numeric"/>
    <category field="science"/>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter="; "
            delimiter-precedes-last="always"
            and="never"/>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" suffix="."/>
  </macro>

  <macro name="journal">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year" font-weight="bold"/>
    </date>
  </macro>

  <macro name="issue">
    <text variable="issue" prefix=" (" suffix=")"/>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="999"
                et-al-use-first="999"
                second-field-align="flush"
                entry-spacing="0"
                line-spacing="2">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=" "/>
      <text macro="title" suffix=" "/>
      <text macro="journal" suffix=" "/>
      <text macro="year" suffix=", "/>
      <text variable="volume" font-style="italic" suffix=""/>
      <text macro="issue"/>
      <text variable="page" prefix=", "/>
    </layout>
  </bibliography>
</style>
